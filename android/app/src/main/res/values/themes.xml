<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="paper_ground">#F1ECE6</color>
    <color name="ink">#1D1C1A</color>
    <color name="leaf">#2E7A3C</color>

    <style name="Theme.Echo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/paper_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_monochrome</item>
    </style>
</resources>
