# Public Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical production origin. Required in production; never set to localhost there.
APP_URL=https://example.com

# Echo MCP OAuth 2.1 uses this Supabase Auth project. In the dashboard enable
# OAuth Server + Dynamic Client Registration and set Authorization Path to /oauth/consent.
# Temporary one-release owner-only compatibility; keep false for new installations.
MCP_LEGACY_TOKEN_ENABLED=false
MCP_SHARED_SECRET=
MCP_USER_ID=

# ElevenLabs
# The existing platform connection is used only for this Supabase auth user.
ELEVENLABS_OWNER_USER_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_TURKISH_VOICE_ID=

# Base64-encoded 32-byte key used to encrypt users' ElevenLabs API keys at rest.
USER_CREDENTIALS_ENCRYPTION_KEY=
