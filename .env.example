# Public Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical production origin. Required in production; never set to localhost there.
APP_URL=https://example.com

# ElevenLabs
# The existing platform connection is used only for this Supabase auth user.
ELEVENLABS_OWNER_USER_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_TURKISH_VOICE_ID=

# Base64-encoded 32-byte key used to encrypt users' ElevenLabs API keys at rest.
USER_CREDENTIALS_ENCRYPTION_KEY=
